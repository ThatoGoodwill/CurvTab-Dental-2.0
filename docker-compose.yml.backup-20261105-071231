services:
  db:
    image: postgres:16
    container_name: curvtab-db
    environment:
      POSTGRES_USER: curvtab
      POSTGRES_PASSWORD: curvtab123
      POSTGRES_DB: curvtabdb
    ports:
      - "5432:5432"
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U curvtab -d curvtabdb"]
      interval: 3s
      timeout: 3s
      retries: 10

  api:
    build:
      context: .
      dockerfile: Dockerfile
    container_name: curvtab-api
    depends_on:
      db:
        condition: service_healthy
    ports:
      - "8080:8080"
    volumes:
      - ./clinical-media:/app/clinical-media
      - ./practice-media:/app/practice-media
    environment:
      ASPNETCORE_ENVIRONMENT: Development
      ConnectionStrings__DentalDatabase: "Host=db;Port=5432;Database=curvtabdb;Username=curvtab;Password=curvtab123"
      Bootstrap__SuperAdminEmail: "admin@curvtab.local"
      Bootstrap__SuperAdminPassword: "CurvTabAdmin123!"