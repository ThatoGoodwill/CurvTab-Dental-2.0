
/* CT_CHARTING_PATIENT_NAV_V1 */

.ct-chart-select {
  width: 100%;
  max-width: 640px;
  margin: 12px auto 32px;
  padding: clamp(20px, 3vw, 32px);
  border: 1px solid var(--ct-border, #344963);
  border-radius: 20px;
  background: var(--ct-panel, #203247);
  color: inherit;
  display: grid;
  gap: 20px;
  box-sizing: border-box;
}

.ct-chart-select-heading {
  display: grid;
  justify-items: center;
  text-align: center;
  gap: 11px;
}

.ct-chart-select-icon {
  width: 64px;
  height: 64px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background: color-mix(
    in srgb,
    var(--practice-primary, #b99008) 14%,
    transparent
  );
  color: var(--practice-primary, #b99008);
}

.ct-chart-select-heading h2 {
  margin: 0;
  font-size: clamp(20px, 3vw, 25px);
}

.ct-chart-select-heading p {
  margin: 0;
  font-size: 13px;
  line-height: 1.6;
  opacity: .75;
}

.ct-chart-patient-search {
  width: 100%;
  min-width: 0;
  padding: 14px 16px;
  border: 1px solid #8fa4ba;
  border-radius: 11px;
  background: transparent;
  color: inherit;
  font: inherit;
  box-sizing: border-box;
}

.ct-chart-patient-results {
  display: grid;
  gap: 9px;
  max-height: 420px;
  overflow-y: auto;
}

.ct-chart-patient-option {
  display: flex;
  align-items: center;
  gap: 13px;
  width: 100%;
  padding: 13px;
  border: 1px solid transparent;
  border-radius: 11px;
  background: rgba(125, 145, 170, .09);
  color: inherit;
  font: inherit;
  text-align: left;
  cursor: pointer;
}

.ct-chart-patient-option:hover {
  border-color: var(--practice-primary, #b99008);
  background: color-mix(
    in srgb,
    var(--practice-primary, #b99008) 9%,
    transparent
  );
}

.ct-chart-patient-avatar,
.ct-chart-workspace-avatar {
  display: grid;
  place-items: center;
  flex-shrink: 0;
  width: 42px;
  height: 42px;
  border: 1px solid var(--practice-primary, #b99008);
  border-radius: 50%;
  font-size: 13px;
  font-weight: 800;
}

.ct-chart-patient-name {
  display: grid;
  gap: 4px;
  flex: 1;
  min-width: 0;
}

.ct-chart-patient-name strong {
  font-size: 14px;
}

.ct-chart-patient-name small {
  opacity: .65;
  font-size: 11px;
}

.ct-chart-select-empty {
  text-align: center;
  padding: 22px;
  opacity: .75;
}

.ct-chart-workspace-heading {
  display: grid;
  gap: 16px;
  margin-bottom: 20px;
  padding: 18px 20px;
  border: 1px solid #9aabbc55;
  border-radius: 14px;
  background: rgba(125, 145, 170, .07);
}

.ct-chart-change-patient {
  justify-self: start;
  padding: 9px 13px;
  border: 1px solid #9aabbc88;
  border-radius: 9px;
  background: transparent;
  color: inherit;
  font: inherit;
  font-size: 12px;
  font-weight: 700;
  cursor: pointer;
}

.ct-chart-workspace-identity {
  display: flex;
  align-items: center;
  gap: 13px;
}

.ct-chart-workspace-identity h2 {
  margin: 0 0 5px;
  font-size: 21px;
}

.ct-chart-workspace-identity p {
  margin: 0;
  opacity: .7;
  font-size: 12px;
}

.ct-chart-patient-option:focus-visible,
.ct-chart-change-patient:focus-visible,
.ct-chart-patient-search:focus-visible {
  outline: 3px solid var(--practice-primary, #b99008);
  outline-offset: 2px;
}

@media(max-width: 600px) {
  .ct-chart-select {
    padding: 18px;
  }

  .ct-chart-workspace-heading {
    padding: 15px;
  }
}
